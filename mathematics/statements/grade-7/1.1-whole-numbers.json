        },
        {
          "id": "51b2ff85-ef71-4215-a09b-75ad90b91e14",
          "code": "7/1.1/n03",
          "type": "progression",
          "text": "More complex financial contexts for solving problems",
          "page": 39
        },
        {
          "id": "9cec6c32-d476-4fa5-a73b-09673845f9d9",
          "code": "7/1.1/n04",
          "type": "progression",
          "text": "In Grade 7 learners consolidate number knowledge and calculation techniques for whole numbers, developed in the Intermediate Phase.",
          "page": 39
        }
